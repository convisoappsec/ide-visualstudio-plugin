<Project>
  <Import Sdk="Microsoft.NET.Sdk" Project="Sdk.props" />

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <OutputType>Library</OutputType>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <GeneratePkgDefFile>true</GeneratePkgDefFile>
    <IncludeAssemblyInVSIXContainer>true</IncludeAssemblyInVSIXContainer>
    <IncludeDebugSymbolsInVSIXContainer>false</IncludeDebugSymbolsInVSIXContainer>
    <CopyBuildOutputToOutputDirectory>true</CopyBuildOutputToOutputDirectory>
    <UseCodebase>true</UseCodebase>
    <VssdkCompatibleExtension>true</VssdkCompatibleExtension>
    <VSToolsPath Condition="'$(VSToolsPath)' == ''">$(MSBuildExtensionsPath32)\Microsoft\VisualStudio\v$(VisualStudioVersion)</VSToolsPath>
    <RootNamespace>Conviso.Platform.VisualStudio</RootNamespace>
    <AssemblyName>Conviso.Platform.VisualStudio</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Design" />
    <Reference Include="System.Security" />
    <!-- VSIX projects do not reliably infer the runtime closure of PackageReference.
         Force the JSON runtime and its net472 dependencies into the VSIX container. -->
    <PackageReference Include="System.Text.Json" Version="8.0.5" ForceIncludeInVSIX="true" />
    <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="8.0.0" ForceIncludeInVSIX="true" />
    <PackageReference Include="System.Buffers" Version="4.5.1" ForceIncludeInVSIX="true" />
    <PackageReference Include="System.Memory" Version="4.5.5" ForceIncludeInVSIX="true" />
    <PackageReference Include="System.Runtime.CompilerServices.Unsafe" Version="6.0.0" ForceIncludeInVSIX="true" />
    <PackageReference Include="System.Text.Encodings.Web" Version="8.0.0" ForceIncludeInVSIX="true" />
    <PackageReference Include="System.Threading.Tasks.Extensions" Version="4.5.4" ForceIncludeInVSIX="true" />
    <PackageReference Include="Microsoft.VisualStudio.SDK" Version="17.0.32112.339" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.VSSDK.BuildTools" Version="17.13.2126" PrivateAssets="all" />
    <PackageReference Include="System.Collections.Immutable"
                  Version="8.0.0"
                  PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <VSCTCompile Include="Conviso.Platform.VisualStudioPackage.vsct">
      <ResourceName>Menus.ctmenu</ResourceName>
    </VSCTCompile>
    <None Include="source.extension.vsixmanifest">
      <SubType>Designer</SubType>
    </None>
  </ItemGroup>

  <Import Sdk="Microsoft.NET.Sdk" Project="Sdk.targets" />
  <Import Project="$(VSToolsPath)\VSSDK\Microsoft.VSSDK.targets" Condition="'$(VSToolsPath)' != ''" />
</Project>
