<UserControl
    x:Class="Conviso.Platform.VisualStudio.ToolWindows.PipelineBreaksToolWindowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.8*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Pipeline Breaks" />
        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,8,0,12">
            <Button Width="100" Content="Refresh" Command="{Binding RefreshCommand}" />
            <TextBlock Margin="12,4,0,0" Foreground="Gray" Text="{Binding Status}" />
        </StackPanel>
        <DataGrid
            Grid.Row="2"
            Grid.Column="0"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            ItemsSource="{Binding Items}"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" />
                <DataGridTextColumn Header="Executed" Binding="{Binding ExecutionDate}" Width="150" />
                <DataGridTextColumn Header="Triggered By" Binding="{Binding TriggeredBy}" Width="160" />
                <DataGridTextColumn Header="Asset" Binding="{Binding AssetName}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Grid.Column="2" Padding="12" Background="#F7F7F7" CornerRadius="6">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="Execution Details" />
                <TextBlock Margin="0,8,0,0" Text="{Binding DetailStatus, StringFormat=Status: {0}}" />
                <TextBlock Margin="0,4,0,0" Text="{Binding DetailExecutionDate, StringFormat=Execution Date: {0}}" TextWrapping="Wrap" />
                <TextBlock Margin="0,4,0,0" Text="{Binding DetailTriggeredBy, StringFormat=Triggered By: {0}}" TextWrapping="Wrap" />
                <TextBlock Margin="0,4,0,0" Text="{Binding DetailSource, StringFormat=Source: {0}}" TextWrapping="Wrap" />
                <TextBlock Margin="0,4,0,0" Text="{Binding DetailAssetName, StringFormat=Asset: {0}}" TextWrapping="Wrap" />
                <TextBlock Margin="0,12,0,4" Text="Reason" FontWeight="SemiBold" />
                <TextBlock Text="{Binding DetailReasonText}" TextWrapping="Wrap" />
                <TextBlock Margin="0,12,0,0" Foreground="Gray" Text="{Binding DetailCommandStatus}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
