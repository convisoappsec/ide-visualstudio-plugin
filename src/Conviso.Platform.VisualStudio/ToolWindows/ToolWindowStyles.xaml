<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vs="clr-namespace:Microsoft.VisualStudio.Shell;assembly=Microsoft.VisualStudio.Shell.15.0">
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vs:VsBrushes.ControlOutlineKey}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,8,0,4" />
    </Style>
    <Style x:Key="StatusText" TargetType="TextBlock">
        <Setter Property="Opacity" Value="0.75" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style TargetType="Button">
        <Setter Property="MinWidth" Value="88" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="Margin" Value="0,0,8,8" />
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="4,2" />
        <Setter Property="Background" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowBackgroundKey}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vs:VsBrushes.ControlOutlineKey}}" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Background" Value="{DynamicResource {x:Static vs:VsBrushes.ComboBoxBackgroundKey}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vs:VsBrushes.ComboBoxBorderKey}}" />
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Background" Value="{DynamicResource {x:Static vs:VsBrushes.DropDownBackgroundKey}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:VsBrushes.WindowTextKey}}" />
    </Style>
    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowBackgroundKey}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vs:VsBrushes.ControlOutlineKey}}" />
    </Style>
    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowBackgroundKey}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}" />
        <Setter Property="RowBackground" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowBackgroundKey}}" />
        <Setter Property="AlternatingRowBackground" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowBackgroundKey}}" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource {x:Static vs:VsBrushes.ControlOutlineKey}}" />
        <Setter Property="VerticalGridLinesBrush" Value="{DynamicResource {x:Static vs:VsBrushes.ControlOutlineKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vs:VsBrushes.ControlOutlineKey}}" />
    </Style>
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="Background" Value="{DynamicResource {x:Static vs:VsBrushes.GridHeadingBackgroundKey}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:VsBrushes.GridHeadingTextKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vs:VsBrushes.GridLineKey}}" />
    </Style>
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowBackgroundKey}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTextKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static vs:VsBrushes.ControlOutlineKey}}" />
    </Style>
    <Style TargetType="TabItem">
        <Setter Property="Background" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTabGradientKey}}" />
        <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTabTextKey}}" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTabMouseOverTextKey}}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTabSelectedTabKey}}" />
                <Setter Property="Foreground" Value="{DynamicResource {x:Static vs:VsBrushes.ToolWindowTabSelectedTextKey}}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
