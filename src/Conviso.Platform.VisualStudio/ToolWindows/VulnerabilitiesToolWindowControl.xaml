<UserControl
    x:Class="Conviso.Platform.VisualStudio.ToolWindows.VulnerabilitiesToolWindowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock FontSize="18" FontWeight="SemiBold" Text="Vulnerabilities" />
        <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Orientation="Horizontal" Margin="0,8,0,12">
            <Button Width="100" Content="Refresh" Command="{Binding RefreshCommand}" />
            <TextBlock Margin="12,4,0,0" Foreground="Gray" Text="{Binding Status}" />
        </StackPanel>
        <DataGrid
            Grid.Row="2"
            Grid.Column="0"
            AutoGenerateColumns="False"
            IsReadOnly="True"
            ItemsSource="{Binding Items}"
            SelectedItem="{Binding SelectedItem, Mode=TwoWay}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Severity" Binding="{Binding Severity}" Width="110" />
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="130" />
                <DataGridTextColumn Header="Asset" Binding="{Binding AssetName}" Width="180" />
                <DataGridTextColumn Header="Title" Binding="{Binding Title}" Width="*" />
            </DataGrid.Columns>
        </DataGrid>

        <Border Grid.Row="2" Grid.Column="2" Padding="12" Background="#F7F7F7" CornerRadius="6" DataContext="{Binding Details}">
            <StackPanel>
                <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding Title}" />
                <TextBlock Margin="0,8,0,0" Text="{Binding Description}" TextWrapping="Wrap" />
                <TextBlock Margin="0,8,0,0" Text="{Binding Severity, StringFormat=Severity: {0}}" />
                <TextBlock Margin="0,4,0,0" Text="{Binding Status, StringFormat=Status: {0}}" />
                <TextBlock Margin="0,4,0,0" Text="{Binding AssetName, StringFormat=Asset: {0}}" />
                <Button Width="120" Margin="0,12,0,0" HorizontalAlignment="Left" Command="{Binding GenerateFixCommand}" Content="Generate Fix" />
                <TextBlock Margin="0,16,0,4" Text="New status" />
                <TextBox Text="{Binding NewStatus, UpdateSourceTrigger=PropertyChanged}" />
                <Button Width="120" Margin="0,12,0,0" HorizontalAlignment="Left" Command="{Binding UpdateStatusCommand}" Content="Update Status" />
                <TextBlock Margin="0,12,0,0" Foreground="Gray" Text="{Binding CommandStatus}" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
