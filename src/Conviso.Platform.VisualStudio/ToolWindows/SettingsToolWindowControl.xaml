<UserControl
    x:Class="Conviso.Platform.VisualStudio.ToolWindows.SettingsToolWindowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <TextBlock FontSize="18" FontWeight="SemiBold" Text="Conviso Settings" />

            <TextBlock Grid.Row="1" Margin="0,16,0,4" Text="API Base URL" />
            <TextBox Grid.Row="2" Text="{Binding ApiBaseUrl, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="3" Margin="0,16,0,4" Text="API Token" />
            <TextBox Grid.Row="4" Text="{Binding ApiToken, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="5" Margin="0,16,0,4" Text="Company ID" />
            <TextBox Grid.Row="6" Text="{Binding CompanyId, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="7" Margin="0,16,0,4" Text="Requirements Scope ID" />
            <TextBox Grid.Row="8" Text="{Binding RequirementsScopeId, UpdateSourceTrigger=PropertyChanged}" />

            <TextBlock Grid.Row="9" Margin="0,16,0,4" Text="Broker Endpoint" />
            <TextBox Grid.Row="10" Text="{Binding BrokerEndpoint, UpdateSourceTrigger=PropertyChanged}" />

            <StackPanel Grid.Row="11" Margin="0,16,0,0">
                <TextBlock Text="Broker API Key" Margin="0,0,0,4" />
                <TextBox Text="{Binding BrokerApiKey, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Margin="0,12,0,0" Foreground="Gray" Text="Secrets are stored using the current Windows user protection." TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                    <Button Width="120" HorizontalAlignment="Left" Command="{Binding SaveCommand}" Content="Save Settings" />
                    <Button Width="90" Margin="8,0,0,0" HorizontalAlignment="Left" Command="{Binding TestApiCommand}" Content="Test API" />
                    <Button Width="100" Margin="8,0,0,0" HorizontalAlignment="Left" Command="{Binding TestBrokerCommand}" Content="Test Broker" />
                    <Button Width="110" Margin="8,0,0,0" HorizontalAlignment="Left" Command="{Binding ResetDefaultsCommand}" Content="Use Defaults" />
                </StackPanel>
                <TextBlock Margin="0,12,0,0" Foreground="Gray" Text="{Binding Status}" />
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
