<UserControl
    x:Class="Conviso.Platform.VisualStudio.ToolWindows.ChatToolWindowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock
            FontSize="18"
            FontWeight="SemiBold"
            Text="Conviso Platform" />

        <StackPanel Grid.Row="1" Margin="0,8,0,16">
            <TextBlock Foreground="Gray" Text="{Binding Status}" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Width="120" HorizontalAlignment="Left" Command="{Binding ConnectCommand}" Content="Connect Chat" />
                <Button Width="120" Margin="8,0,0,0" HorizontalAlignment="Left" Command="{Binding DisconnectCommand}" Content="Disconnect" />
                <Button Width="120" Margin="8,0,0,0" HorizontalAlignment="Left" Command="{Binding AttachSelectionCommand}" Content="Attach Selection" />
                <Button Width="160" Margin="8,0,0,0" HorizontalAlignment="Left" Command="{Binding AnalyzeSelectionCommand}" Content="Analyze + Suggest Fix" />
                <Button Width="140" Margin="8,0,0,0" HorizontalAlignment="Left" Command="{Binding CheckSimilarIssuesCommand}" Content="Check Similar Issues" />
                <Button Width="130" Margin="8,0,0,0" HorizontalAlignment="Left" Command="{Binding ApplySuggestedFixCommand}" Content="Apply Suggested Fix" />
                <Button Width="120" Margin="8,0,0,0" HorizontalAlignment="Left" Command="{Binding MarkResponseHelpfulCommand}" Content="Mark Helpful" />
            </StackPanel>
            <Border Margin="0,12,0,0" Padding="8" Background="#F7F7F7" CornerRadius="4">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Text="{Binding AttachedContextSummary}" TextWrapping="Wrap" />
                    <Button DockPanel.Dock="Right" Width="60" Margin="12,0,0,0" HorizontalAlignment="Right" Command="{Binding ClearAttachedContextCommand}" Content="Clear" />
                </DockPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="2*" />
                <RowDefinition Height="12" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ListBox
                Grid.Row="0"
                ItemsSource="{Binding Transcript}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,0,8" Padding="8" Background="#F4F4F4" CornerRadius="4">
                            <StackPanel>
                                <TextBlock FontWeight="SemiBold" Text="{Binding Role}" />
                                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Content}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBox
                Grid.Row="2"
                Grid.RowSpan="2"
                Margin="0,0,0,12"
                AcceptsReturn="True"
                TextWrapping="Wrap"
                VerticalScrollBarVisibility="Auto"
                Text="{Binding Message, UpdateSourceTrigger=PropertyChanged}" />

            <Button
                Grid.Row="3"
                Width="120"
                HorizontalAlignment="Left"
                Command="{Binding SendCommand}"
                Content="Send Message" />
        </Grid>
    </Grid>
</UserControl>
